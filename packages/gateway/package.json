{
	"name": "@mesh-flow/gateway",
	"version": "0.0.0",
	"description": "The mesh-flow gateway: runs credentialed tools and model calls on the host, for runs in sandboxes that hold no credentials",
	"keywords": [
		"agents",
		"credentials",
		"gateway",
		"mesh-flow",
		"workflow"
	],
	"homepage": "https://github.com/Marvin-Brouwer/code-workflow/tree/main/packages/gateway#readme",
	"bugs": "https://github.com/Marvin-Brouwer/code-workflow/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Marvin-Brouwer/code-workflow.git",
		"directory": "packages/gateway"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/_module/gateway.mts",
			"types": "./dist/gateway.d.mts",
			"import": "./dist/gateway.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "^1.5.0",
		"@mesh-flow/protocol": "workspace:*",
		"@napi-rs/keyring": "^2.1.2",
		"proper-lockfile": "^4.1.2",
		"write-file-atomic": "^7.0.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"@types/proper-lockfile": "^4.1.4",
		"@types/write-file-atomic": "^4.0.3",
		"tsdown": "^0.23.4",
		"typescript": "~6.0.3",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=22"
	}
}
