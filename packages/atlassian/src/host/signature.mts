import { projectUrl } from '@mesh-flow/gateway'

/**
 * `body` as the connector posts it, in Markdown: under it, a line in italics that says what wrote
 * it and in which run, so a reader knows an agent wrote it and where to look. No rule above it:
 * the wiki markup Data Center takes makes a heading of one.
 */
export function signed(body: string, runId: string): string {
	return [body.trimEnd(), '', `_Generated by [@mesh-flow/*](${projectUrl}) in run \`${runId}\`_`].join('\n')
}
