import { describe, expect, test } from 'vitest'
import { openPullRequest, pullRequest as getPullRequest, updatePullRequest } from '../src/pull-request/pull-request.mts'
import { push } from '../src/repository/push.mts'
import { checkout } from '../src/repository/repository.mts'
import {
	branch,
	changeLogin,
	connectedGithub,
	firstPullRequest,
	issueRef,
	promptlyMs,
	repositoryName,
	sameSite,
} from './support/connected-github.mts'
import { askedForInput, runOnGateway } from './support/test-run.mts'

/** What a person wrote over the description while a new one was written. */
const personsEdit = { title: 'Keep the session', description: 'Do not merge before Friday.' }

/** What the new text was written from: the first pull request as it was opened. */
const basedOnSameSite = { ...sameSite, repository: repositoryName, number: firstPullRequest }

/** The text after the second fix, which adds Secure to the cookie. */
const secure = { title: 'Keep the session on Safari and Firefox', description: 'Sets SameSite and Secure.' }

/** An issue whose `Fixes #70` starts with the text of `Fixes #7`, which mustn't count as closing #7. */
const otherIssueNumber = 70

describe('openPullRequest', () => {
	test('signs the description with the run id, the issue it closes and the commit it describes', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const { head } = await push(repository)({ message: 'Set SameSite' })
			await openPullRequest(repository, { ...sameSite, closes: issueRef })
			return head
		})
		const head = await run.result

		// Assert
		expect(api.pullRequest(repositoryName, firstPullRequest).body).toBe(
			[
				'Sets SameSite.',
				'',
				'---',
				'Generated by [`@mesh-flow/*`](https://github.com/Marvin-Brouwer/code-workflow)',
				`\`${run.runId}\` Fixes #7`,
				`<!-- mesh-flow:described:${head} -->`,
			].join('\n'),
		)
	})

	test('keeps the text of the open pull request when it is opened again for the same commit', async () => {
		// Arrange
		const { gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			await openPullRequest(repository, { ...sameSite, closes: issueRef })
			return openPullRequest(repository, { ...secure, closes: issueRef })
		})
		const rerun = await run.result

		// Assert
		expect(rerun).toMatchObject(sameSite)
	})

	test('gives the open pull request the new text for the same commit when it lacks the issue it should close', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()
		api.issue(repositoryName, otherIssueNumber)

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			await openPullRequest(repository, { ...sameSite, closes: { repository: repositoryName, number: otherIssueNumber } })
			return openPullRequest(repository, { ...secure, closes: issueRef })
		})
		const reopened = await run.result

		// Assert
		expect(reopened).toMatchObject(secure)
		expect(api.pullRequest(repositoryName, firstPullRequest).body).toContain(`\`${run.runId}\` Fixes #7\n`)
	})

	test('gives the open pull request the new text when it is opened again for a new commit', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			await openPullRequest(repository, sameSite)
			await changeLogin(repository, 'SameSite=None; Secure\n')
			return openPullRequest(repository, secure)
		})
		const moved = await run.result

		// Assert
		expect(api.repository(repositoryName).pulls.size).toBe(1)
		expect(moved).toMatchObject(secure)
	})

	test('settles promptly when the run stops while GitHub never answers the new text of the open pull request', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()
		const { promise: stalled, resolve } = Promise.withResolvers<undefined>()
		api.hold = (method, requestPath) => {
			if (method !== 'PATCH' || !requestPath.endsWith(`/pulls/${String(firstPullRequest)}`)) return undefined
			resolve(undefined)
			return new Promise(() => undefined)
		}

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			await openPullRequest(repository, sameSite)
			await changeLogin(repository, 'SameSite=None; Secure\n')
			return openPullRequest(repository, secure)
		})
		await stalled
		const started = performance.now()
		run.controller.abort(new Error('The run stopped.'))
		await run.outcome

		// Assert
		expect(performance.now() - started).toBeLessThan(promptlyMs)
	})
})

describe('updatePullRequest', () => {
	test('writes the new text and the commit it describes', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const pullRequest = await openPullRequest(repository, sameSite)
			await changeLogin(repository, 'SameSite=None; Secure\n')
			const { head } = await push(repository)({ message: 'Set Secure too' })
			const updated = await updatePullRequest(pullRequest, { ...secure, describedSha: head })
			return { head, updated }
		})
		const { head, updated } = await run.result

		// Assert
		expect(updated).toMatchObject({ ...secure, describedSha: head })
		expect(updated.skipped).toBeUndefined()
		expect(api.pullRequest(repositoryName, firstPullRequest).title).toBe(secure.title)
	})

	test('skips a pull request that already has the text', async () => {
		// Arrange
		const { gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const { head } = await push(repository)({ message: 'Set SameSite' })
			const pullRequest = await openPullRequest(repository, sameSite)
			return updatePullRequest(pullRequest, { ...sameSite, describedSha: head })
		})
		const updated = await run.result

		// Assert
		expect(updated).toMatchObject({ ...sameSite, skipped: 'unchanged' })
	})

	test('skips a pull request whose text only differs in the line breaks GitHub saved it with', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const { head } = await push(repository)({ message: 'Set SameSite' })
			const pullRequest = await openPullRequest(repository, {
				title: sameSite.title,
				description: 'Sets SameSite.\n\nOn the session cookie.',
			})
			const stored = api.pullRequest(repositoryName, pullRequest.number)
			api.pullRequest(repositoryName, pullRequest.number, { body: stored.body.replaceAll('\n', '\r\n') })
			return updatePullRequest(pullRequest, {
				title: sameSite.title,
				description: 'Sets SameSite.\n\nOn the session cookie.',
				describedSha: head,
			})
		})
		const updated = await run.result

		// Assert
		expect(updated.skipped).toBe('unchanged')
	})

	test('skips a pull request that another run signed with the same text', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const { head } = await push(repository)({ message: 'Set SameSite' })
			const pullRequest = await openPullRequest(repository, sameSite)
			const stored = api.pullRequest(repositoryName, pullRequest.number)
			api.pullRequest(repositoryName, pullRequest.number, { body: stored.body.replace(/`run-\d+`/, '`run-earlier`') })
			return updatePullRequest(pullRequest, { ...sameSite, describedSha: head })
		})
		const updated = await run.result

		// Assert
		expect(updated.skipped).toBe('unchanged')
	})

	test('refuses a text written from another pull request', async () => {
		// Arrange
		const { gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const pullRequest = await openPullRequest(repository, sameSite)
			return updatePullRequest(pullRequest, { ...secure, basedOn: { ...basedOnSameSite, number: firstPullRequest + 1 } })
		})

		// Assert
		await expect(run.result).rejects.toThrow('written from team/app#2, not from team/app#1')
	})

	test('leaves a closed pull request as it is', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const pullRequest = await openPullRequest(repository, sameSite)
			api.pullRequest(repositoryName, pullRequest.number, { state: 'closed' })
			return updatePullRequest(pullRequest, secure)
		})
		const updated = await run.result

		// Assert
		expect(updated).toMatchObject({ ...sameSite, state: 'closed', skipped: 'closed' })
		expect(api.pullRequest(repositoryName, firstPullRequest).title).toBe(sameSite.title)
	})

	test('settles promptly when the run stops while GitHub never answers the new text', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()
		const { promise: stalled, resolve } = Promise.withResolvers<undefined>()
		api.hold = (method, requestPath) => {
			if (method !== 'PATCH' || !requestPath.endsWith(`/pulls/${String(firstPullRequest)}`)) return undefined
			resolve(undefined)
			return new Promise(() => undefined)
		}

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const pullRequest = await openPullRequest(repository, sameSite)
			return updatePullRequest(pullRequest, secure)
		})
		await stalled
		const started = performance.now()
		run.controller.abort(new Error('The run stopped.'))
		await run.outcome

		// Assert
		expect(performance.now() - started).toBeLessThan(promptlyMs)
	})
})

describe('an edit while the text was written', () => {
	test('asks before updating over it, and keeps it when the person says no', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(
			gateway,
			async () => {
				const repository = await checkout({ repository: repositoryName, branch })
				await changeLogin(repository, 'SameSite=None\n')
				const pullRequest = await openPullRequest(repository, sameSite)
				api.pullRequest(repositoryName, pullRequest.number, { title: personsEdit.title, body: personsEdit.description })
				return updatePullRequest(pullRequest, { ...secure, basedOn: basedOnSameSite })
			},
			{ inputs: [{ overwrite: false }] },
		)
		const updated = await run.result

		// Assert
		expect(askedForInput(run.messages)).toBe(true)
		expect(updated).toMatchObject({ ...personsEdit, skipped: 'edited' })
		expect(api.pullRequest(repositoryName, firstPullRequest).body).toBe(personsEdit.description)
	})

	test('updates over it when the person says yes', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(
			gateway,
			async () => {
				const repository = await checkout({ repository: repositoryName, branch })
				await changeLogin(repository, 'SameSite=None\n')
				const pullRequest = await openPullRequest(repository, sameSite)
				api.pullRequest(repositoryName, pullRequest.number, { title: personsEdit.title, body: personsEdit.description })
				return updatePullRequest(pullRequest, { ...secure, basedOn: basedOnSameSite })
			},
			{ inputs: [{ overwrite: true }] },
		)
		const updated = await run.result

		// Assert
		expect(updated).toMatchObject(secure)
		expect(api.pullRequest(repositoryName, firstPullRequest).title).toBe(secure.title)
	})

	test('asks before opening over it, and keeps it when the person says no', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(
			gateway,
			async () => {
				const repository = await checkout({ repository: repositoryName, branch })
				await changeLogin(repository, 'SameSite=None\n')
				const pullRequest = await openPullRequest(repository, sameSite)
				api.pullRequest(repositoryName, pullRequest.number, { title: personsEdit.title, body: personsEdit.description })
				await changeLogin(repository, 'SameSite=None; Secure\n')
				return openPullRequest(repository, { ...secure, basedOn: basedOnSameSite })
			},
			{ inputs: [{ overwrite: false }] },
		)
		const reopened = await run.result

		// Assert
		expect(reopened).toMatchObject(personsEdit)
		expect(api.pullRequest(repositoryName, firstPullRequest).title).toBe(personsEdit.title)
	})

	test('updates the pull request it was written from, and opens none when that one was closed meanwhile', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const pullRequest = await openPullRequest(repository, sameSite)
			api.pullRequest(repositoryName, pullRequest.number, { state: 'closed' })
			await changeLogin(repository, 'SameSite=None; Secure\n')
			return openPullRequest(repository, { ...secure, basedOn: basedOnSameSite })
		})
		const reopened = await run.result

		// Assert
		expect(api.repository(repositoryName).pulls.size).toBe(1)
		expect(reopened).toMatchObject({ ...sameSite, state: 'closed' })
	})

	test('asks again when the pull request was edited again while the person answered', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()
		const editedAgain = { title: 'Keep the session', description: 'Do not merge before Monday.' }

		// Act
		const run = await runOnGateway(
			gateway,
			async () => {
				const repository = await checkout({ repository: repositoryName, branch })
				await changeLogin(repository, 'SameSite=None\n')
				const pullRequest = await openPullRequest(repository, sameSite)
				api.pullRequest(repositoryName, pullRequest.number, { title: personsEdit.title, body: personsEdit.description })
				return updatePullRequest(pullRequest, { ...secure, basedOn: basedOnSameSite })
			},
			{
				inputs: [{ overwrite: true }, { overwrite: false }],
				onInput: (index) => {
					if (index === 0) api.pullRequest(repositoryName, firstPullRequest, { body: editedAgain.description })
				},
			},
		)
		const updated = await run.result

		// Assert
		expect(updated).toMatchObject({ ...editedAgain, skipped: 'edited' })
	})

	test('asks when the pull request was edited between the last look and the write', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()
		let reads = 0
		api.hold = (method, requestPath) => {
			if (method !== 'GET' || !requestPath.endsWith(`/pulls/${String(firstPullRequest)}`)) return undefined
			// The host's read, right before it writes: a person saved an edit just after the run's own look.
			if (++reads === 2) api.pullRequest(repositoryName, firstPullRequest, { title: personsEdit.title, body: personsEdit.description })
			return undefined
		}

		// Act
		const run = await runOnGateway(
			gateway,
			async () => {
				const repository = await checkout({ repository: repositoryName, branch })
				await changeLogin(repository, 'SameSite=None\n')
				const pullRequest = await openPullRequest(repository, sameSite)
				return updatePullRequest(pullRequest, { ...secure, basedOn: basedOnSameSite })
			},
			{ inputs: [{ overwrite: false }] },
		)
		const updated = await run.result

		// Assert
		expect(updated).toMatchObject({ ...personsEdit, skipped: 'edited' })
		expect(api.pullRequest(repositoryName, firstPullRequest).body).toBe(personsEdit.description)
	})

	test('settles promptly when the run stops while the person never answers', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()
		const { promise: asked, resolve } = Promise.withResolvers<undefined>()

		// Act
		const run = await runOnGateway(
			gateway,
			async () => {
				const repository = await checkout({ repository: repositoryName, branch })
				await changeLogin(repository, 'SameSite=None\n')
				const pullRequest = await openPullRequest(repository, sameSite)
				api.pullRequest(repositoryName, pullRequest.number, { title: personsEdit.title, body: personsEdit.description })
				return updatePullRequest(pullRequest, { ...secure, basedOn: basedOnSameSite })
			},
			{
				onInput: () => {
					resolve(undefined)
				},
			},
		)
		await asked
		const started = performance.now()
		run.controller.abort(new Error('The run stopped.'))
		await run.outcome

		// Assert
		expect(performance.now() - started).toBeLessThan(promptlyMs)
	})

	test('asks nothing when the pull request still says what the new text was written from', async () => {
		// Arrange
		const { gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const pullRequest = await openPullRequest(repository, sameSite)
			return updatePullRequest(pullRequest, { ...secure, basedOn: basedOnSameSite })
		})
		const updated = await run.result

		// Assert
		expect(askedForInput(run.messages)).toBe(false)
		expect(updated).toMatchObject(secure)
	})
})

describe('pullRequest', () => {
	test('reads a marker someone edited as no described commit', async () => {
		// Arrange
		const { api, gateway } = await connectedGithub()

		// Act
		const run = await runOnGateway(gateway, async () => {
			const repository = await checkout({ repository: repositoryName, branch })
			await changeLogin(repository, 'SameSite=None\n')
			const pullRequest = await openPullRequest(repository, sameSite)
			const stored = api.pullRequest(repositoryName, pullRequest.number)
			api.pullRequest(repositoryName, pullRequest.number, { body: stored.body.replace(/described:[0-9a-f]+/, 'described:not-a-sha') })
			return getPullRequest(pullRequest)
		})
		const edited = await run.result

		// Assert
		expect(edited.describedSha).toBeUndefined()
	})
})
