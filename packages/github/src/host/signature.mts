import { commentMarker } from '../tools/issue-tools.mts'

/** Where the footer of a post links to. */
const projectUrl = 'https://github.com/Marvin-Brouwer/code-workflow'

/** Says what wrote a post, and in which run. */
function footer(runId: string): readonly string[] {
	return ['---', `Generated by [\`@mesh-flow/*\`](${projectUrl})`, `\`${runId}\``]
}

/**
 * `body` as the connector posts it: the footer, then a marker for each of `markerKeys`, which find
 * the post again and keep it out of what a look at a review hands to the run.
 */
export function signed(body: string, runId: string, markerKeys: readonly string[]): string {
	return [body, '', ...footer(runId), ...markerKeys.map(commentMarker)].join('\n')
}
