/** Where the footer of a post links to. */
const projectUrl = 'https://github.com/Marvin-Brouwer/code-workflow'

/**
 * `body` as the connector posts it: with a footer that says what wrote it and in which run, then
 * the markers that find it again and keep it out of what a look at a review hands to the run.
 */
export function signed(body: string, runId: string, markers: readonly string[]): string {
	return [body, '', '---', `Generated by [\`@mesh-flow/*\`](${projectUrl})`, `\`${runId}\``, ...markers].join('\n')
}
