import { commentMarker, markers } from '../tools/issue-tools.mts'

/** Where the footer of a post links to. */
const projectUrl = 'https://github.com/Marvin-Brouwer/code-workflow'

/** The rule the footer starts with, under a blank line. */
const footerRule = '---'

/** The footer's line that says what wrote the post. */
const generatedBy = `Generated by [\`@mesh-flow/*\`](${projectUrl})`

/** Says what wrote a post, and in which run, with `notes` such as a `Fixes` line next to the run id. */
function footer(runId: string, notes: readonly string[]): readonly string[] {
	return [footerRule, generatedBy, [`\`${runId}\``, ...notes].join(' ')]
}

/**
 * `body` as the connector posts it: the footer, with `notes` next to the run id, then a marker for
 * each of `markerKeys`, which find the post again and keep it out of what a look at a review hands
 * to the run.
 */
export function signed(body: string, runId: string, markerKeys: readonly string[], notes: readonly string[] = []): string {
	return [body, '', ...footer(runId, notes), ...markerKeys.map(commentMarker)].join('\n')
}

/**
 * A post as it was written, without the connector's footer and markers. GitHub's editor saves line
 * breaks as `\r\n`, and a person may add a rule of their own, so only the connector's own footer is
 * cut: the last rule followed by its `Generated by` line.
 */
export function unsigned(body: string): string {
	const text = body.replaceAll('\r\n', '\n')
	const start = text.lastIndexOf(`\n\n${footerRule}\n${generatedBy}`)
	return (start === -1 ? text : text.slice(0, start)).replace(markers, '').trimEnd()
}
