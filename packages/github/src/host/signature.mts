import { commentMarker } from '../tools/issue-tools.mts'

/** Where the footer of a post links to. */
const projectUrl = 'https://github.com/Marvin-Brouwer/code-workflow'

/** Where the footer starts: what comes before it is the post as it was written. */
const footerStart = '\n\n---\n'

/** Says what wrote a post, and in which run, after `lines` of its own. */
function footer(runId: string, lines: readonly string[]): readonly string[] {
	return ['---', ...lines, `Generated by [\`@mesh-flow/*\`](${projectUrl})`, `\`${runId}\``]
}

/**
 * `body` as the connector posts it: the footer, starting with `lines` such as a `Fixes` line, then
 * a marker for each of `markerKeys`, which find the post again and keep it out of what a look at a
 * review hands to the run.
 */
export function signed(body: string, runId: string, markerKeys: readonly string[], lines: readonly string[] = []): string {
	return [body, '', ...footer(runId, lines), ...markerKeys.map(commentMarker)].join('\n')
}

/** A signed post as it was written, without the footer: everything before the last footer. */
export function unsigned(body: string): string {
	const start = body.lastIndexOf(footerStart)
	return start === -1 ? body : body.slice(0, start)
}
