{
	"name": "@mesh-flow/ui",
	"version": "0.0.0",
	"description": "The mesh-flow UI: runs, starting workflows and the settings, in a browser on the engine's machine",
	"keywords": [
		"agents",
		"mesh-flow",
		"rooted",
		"ui",
		"workflow"
	],
	"homepage": "https://github.com/Marvin-Brouwer/code-workflow/tree/main/packages/ui#readme",
	"bugs": "https://github.com/Marvin-Brouwer/code-workflow/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Marvin-Brouwer/code-workflow.git",
		"directory": "packages/ui"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./server": {
			"source": "./src/_module/server.mts",
			"types": "./dist/server.d.mts",
			"import": "./dist/server.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsdown && vite build app",
		"dev": "vite app",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json && tsc -p app/tsconfig.json"
	},
	"dependencies": {
		"@hono/node-server": "^2.1.6",
		"@mesh-flow/duration": "workspace:*",
		"@mesh-flow/engine": "workspace:*",
		"@mesh-flow/gateway": "workspace:*",
		"@rooted/components": "1.0.0-beta.1",
		"@rooted/router": "1.0.0-beta.1",
		"@rooted/store": "1.0.0-beta.1",
		"hono": "^4.13.16",
		"open": "^11.0.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsdown": "^0.23.7",
		"typescript": "~6.0.3",
		"vite": "8.3.8",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=26"
	}
}
