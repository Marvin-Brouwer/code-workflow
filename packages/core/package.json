{
	"name": "@mesh-flow/core",
	"version": "0.0.0",
	"description": "The mesh-flow authoring vocabulary: workflows as plain async TypeScript, with agents as calls inside them",
	"keywords": [
		"agents",
		"durable",
		"mesh-flow",
		"workflow"
	],
	"homepage": "https://github.com/Marvin-Brouwer/code-workflow/tree/main/packages/core#readme",
	"bugs": "https://github.com/Marvin-Brouwer/code-workflow/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Marvin-Brouwer/code-workflow.git",
		"directory": "packages/core"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/_module/core.mts",
			"types": "./dist/core.d.mts",
			"import": "./dist/core.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@earendil-works/chord": "^1.5.0",
		"@earendil-works/pi-ai": "^1.5.0",
		"@earendil-works/pi-durable": "^1.5.0",
		"@mesh-flow/protocol": "workspace:*",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"tsdown": "^0.23.4",
		"typescript": "~6.0.3",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=22.18"
	}
}
