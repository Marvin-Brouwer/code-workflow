{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Workspace packages resolve to their sources, so nothing has to be built first.
		"customConditions": ["source"],
		// The runtime's side runs in the sandbox, where Node runs it without a build.
		"erasableSyntaxOnly": true,
		// Node 26 has all of ES2024, such as `toSorted`.
		"lib": ["ES2024"]
	},
	"include": ["src", "test", "tsdown.config.mts", "vitest.config.mts"]
}
