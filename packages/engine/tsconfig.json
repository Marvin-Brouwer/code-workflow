{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Workspace packages resolve to their sources, so nothing has to be built first.
		"customConditions": ["source"],
		// Node 26 has all of ES2024, such as `Promise.withResolvers`, which the gateway's sources use.
		"lib": ["ES2024"]
	},
	"include": ["bin", "src", "test", "tsdown.config.mts", "vitest.config.mts"]
}
