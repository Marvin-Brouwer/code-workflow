{
	"name": "@mesh-flow/duration",
	"version": "0.0.0",
	"description": "Durations for mesh-flow: written as text such as 1h15m, checked at compile time",
	"keywords": [
		"duration",
		"mesh-flow",
		"time",
		"timeout"
	],
	"homepage": "https://github.com/Marvin-Brouwer/code-workflow/tree/main/packages/duration#readme",
	"bugs": "https://github.com/Marvin-Brouwer/code-workflow/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Marvin-Brouwer/code-workflow.git",
		"directory": "packages/duration"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/_module/duration.mts",
			"types": "./dist/duration.d.mts",
			"import": "./dist/duration.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsdown": "^0.23.4",
		"typescript": "~6.0.3",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=26"
	}
}
