{
	"name": "@mesh-flow/code-repository",
	"version": "0.0.0",
	"description": "What the mesh-flow connectors of code hosts share: checkouts and pushes over git bundles, describing a branch, watching a review and sorting its comments",
	"keywords": [
		"agents",
		"git",
		"mesh-flow",
		"workflow"
	],
	"homepage": "https://github.com/Marvin-Brouwer/code-workflow/tree/main/packages/code-repository#readme",
	"bugs": "https://github.com/Marvin-Brouwer/code-workflow/issues",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Marvin-Brouwer/code-workflow.git",
		"directory": "packages/code-repository"
	},
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"source": "./src/_module/code-repository.mts",
			"types": "./dist/code-repository.d.mts",
			"import": "./dist/code-repository.mjs"
		},
		"./host": {
			"source": "./src/_module/host.mts",
			"types": "./dist/host.d.mts",
			"import": "./dist/host.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true,
		"registry": "https://registry.npmjs.org/"
	},
	"scripts": {
		"build": "tsdown",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"@mesh-flow/core": "workspace:*",
		"@mesh-flow/gateway": "workspace:*",
		"@mesh-flow/git": "workspace:*",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@mesh-flow/protocol": "workspace:*",
		"@types/node": "^26.6.6",
		"execa": "^10.2.1",
		"tsdown": "^0.23.4",
		"typescript": "~6.0.3",
		"vitest": "^5.1.0"
	},
	"engines": {
		"node": ">=26"
	}
}
