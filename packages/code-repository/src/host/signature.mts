import { projectUrl } from '@mesh-flow/gateway'
import { withUnixLineBreaks } from '../line-breaks.mts'
import { commentMarker, markerStart } from '../markers.mts'

/** The rule the footer starts with, under a blank line. */
const footerRule = '---'

/** The footer's line that says what wrote the post. */
const generatedBy = `Generated by [\`@mesh-flow/*\`](${projectUrl})`

/** Says what wrote a post, and in which run, with `notes` such as a `Fixes` line next to the run id. */
function footer(runId: string, notes: readonly string[]): readonly string[] {
	return [footerRule, generatedBy, [`\`${runId}\``, ...notes].join(' ')]
}

/** How many lines the footer has before its markers: the rule, `Generated by` and the run id line. */
const footerLineCount = footer('', []).length

/** The run id as the footer writes it: in backticks, at the start of its line. */
const runIdInFooter = /^`[^`]*`/

/** Where the run id line is in a footer that starts at `start`: its last line before the markers. */
function runIdLineIndex(start: number): number {
	return start + footerLineCount - 1
}

/**
 * `body` as the connector posts it: the footer, with `notes` next to the run id, then a marker for
 * each of `markerKeys`, which find the post again and keep it out of what a look at a review hands
 * to the run.
 */
export function signed(body: string, runId: string, markerKeys: readonly string[], notes: readonly string[] = []): string {
	return [body, '', ...footer(runId, notes), ...markerKeys.map(commentMarker)].join('\n')
}

/**
 * A post as it was written, without the connector's footer and markers. A code host's editor saves line
 * breaks as `\r\n`, and a person may add a rule of their own, or text under the footer, so only the
 * connector's own footer is cut: its rule, `Generated by` line, run id line and markers. What a
 * person wrote under it stays.
 */
export function unsigned(body: string): string {
	const lines = linesOf(body)
	const start = footerStart(lines)
	if (start === -1) return withoutMarkers(lines).join('\n').trimEnd()
	// The rule, `Generated by` and the run id line, then the markers that follow.
	let end = start + footerLineCount
	while (end < lines.length && (lines[end] ?? '').startsWith(markerStart)) end++
	const tail = lines.slice(end)
	// What a person wrote right under the footer keeps a paragraph of its own.
	const under = tail.length > 0 && tail[0] !== '' ? ['', ...tail] : tail
	return withoutMarkers([...lines.slice(0, start - 1), ...under])
		.join('\n')
		.trimEnd()
}

/** The lines that aren't one of the connector's markers. */
function withoutMarkers(lines: readonly string[]): string[] {
	return lines.filter((line) => !line.startsWith(markerStart))
}

/** The run id line of a post's last connector footer, with the notes next to the run id. */
export function runIdLine(body: string): string | undefined {
	const lines = linesOf(body)
	const start = footerStart(lines)
	return start === -1 ? undefined : lines[runIdLineIndex(start)]
}

/** Whether the connector's last footer in `body` names `runId`: whether that run wrote the post, or last rewrote it. */
export function signedBy(body: string, runId: string): boolean {
	return runIdLine(body)?.startsWith(`\`${runId}\``) ?? false
}

/**
 * `body` with `\n` line breaks and without the run id in its last connector footer, the notes next
 * to it kept: two signings of the same text by different runs compare the same.
 */
export function withoutRunId(body: string): string {
	const lines = linesOf(body)
	const start = footerStart(lines)
	if (start === -1) return lines.join('\n')
	const at = runIdLineIndex(start)
	return lines.map((line, index) => (index === at ? line.replace(runIdInFooter, '') : line)).join('\n')
}

/** A body's lines, whichever line breaks a code host's editor saved it with. */
function linesOf(body: string): string[] {
	return withUnixLineBreaks(body).split('\n')
}

/** Where the last connector footer starts: its rule, under a blank line and over the `Generated by` line. */
function footerStart(lines: readonly string[]): number {
	return lines.findLastIndex((line, index) => line === footerRule && lines[index + 1] === generatedBy && lines[index - 1] === '')
}
