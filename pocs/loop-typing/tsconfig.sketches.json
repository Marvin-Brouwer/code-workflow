{
	// Type-checks the option C sketches in examples/ and packages/ against src/core.mts.
	// Bundler resolution because the sketches use extensionless relative imports.
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "preserve",
		"moduleResolution": "bundler",
		"paths": {
			"@mesh-flow/core": ["./src/core.mts"],
			"@mesh-flow/git": ["./stubs/git.mts"],
			"@mesh-flow/connector-atlassian": ["../../packages/connector-atlassian/src/index.mts"],
			"@mesh-flow/connector-gitlab": ["../../packages/connector-gitlab/src/index.mts"],
			"@mesh-flow/toolchain-dotnet": ["../../packages/toolchain-dotnet/src/index.mts"],
			"@mesh-flow/preset-development": ["../../packages/preset-development/src/index.mts"],
			"zod": ["./node_modules/zod"]
		},
		"rootDirs": [
			"../../packages/connector-atlassian/src",
			"./stubs/connector-atlassian",
			"../../packages/connector-gitlab/src",
			"./stubs/connector-gitlab",
			"../../packages/toolchain-dotnet/src",
			"./stubs/toolchain-dotnet"
		]
	},
	"include": [
		"../../examples/example/**/*.mts",
		"../../packages/connector-atlassian/src/**/*.mts",
		"../../packages/connector-gitlab/src/**/*.mts",
		"../../packages/toolchain-dotnet/src/**/*.mts",
		"../../packages/preset-development/src/**/*.mts",
		"./stubs/**/*.mts"
	]
}
